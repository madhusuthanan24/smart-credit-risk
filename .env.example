# Application Environment (production, development, test)
ENVIRONMENT=production

# Database Connection (PostgreSQL recommended for production, SQLite for local dev)
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/credit_risk

# JWT & Security Configuration (In production, SECRET_KEY must be >= 32 characters and non-default)
SECRET_KEY=CHANGE_ME_TO_A_MINIMUM_32_CHAR_RANDOM_SECRET_KEY!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Allowed Frontend Origins (Comma-separated; wildcard '*' forbidden in production with credentials)
FRONTEND_URL=http://localhost:3000,http://localhost:5173

# Staff Provisioning Invite Codes
ADMIN_INVITE_CODE=ADMIN123KEY
CREDIT_OFFICER_INVITE_CODE=OFFICER123KEY

# ML Model Paths
MODEL_PATH=models/final_model.joblib
PREPROCESSOR_PATH=models/preprocessing_pipeline.joblib
THRESHOLD_PATH=models/threshold_config.json
METADATA_PATH=models/final_model_metadata.json

# NVIDIA AI Explainability Layer
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TIMEOUT_SECONDS=20.0

